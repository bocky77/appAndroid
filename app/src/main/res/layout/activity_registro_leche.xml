<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_leche"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegistroLecheActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <ImageView
            android:id="@+id/imagenLeche"
            android:layout_width="150dp"
            android:layout_height="130dp"
            android:layout_marginBottom="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/vacalacteos" />

        <TextView
            android:id="@+id/tituloLeche"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:text="Registro de Leche"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLitros"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="15dp"
            android:hint="Cantidad en litros"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background" />

        <EditText
            android:id="@+id/etProveedor"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="30dp"
            android:hint="Proveedor o Finca"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background" />

        <Button
            android:id="@+id/btnGuardarLeche"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:text="GUARDAR REGISTRO"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/azul_lacteos" />
    </LinearLayout>

</FrameLayout>